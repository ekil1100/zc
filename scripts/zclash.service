[Unit]
Description=zclash proxy service
Documentation=https://github.com/ekil1100/zclash
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/zclash start --foreground
# No ExecReload: `zclash reload` falls back to a full restart, which would kill
# the supervised --foreground MainPID and escape systemd. Use
# `systemctl restart zclash` to apply config changes.
ExecStop=/usr/local/bin/zclash stop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
